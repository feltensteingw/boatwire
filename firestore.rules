rules_version = '2';

// Each signed-in user can only see and change their own boats:
//   users/{uid}/boats/{boatId}  { name, data (project JSON), version, createdAt, updatedAt }
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/boats/{boatId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validBoat() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'data', 'version', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() <= 200
          && d.data is string && d.data.size() <= 900000
          && d.version is int
          && d.updatedAt == request.time;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validBoat();
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
