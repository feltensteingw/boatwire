{
  "name": "boatwire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "build:e2e": "VITE_CLOUD_FAKE=1 vite build --outDir dist-e2e --logLevel warn",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "elkjs": "^0.9.3",
    "firebase": "^11.1.0",
    "html-to-image": "^1.11.11",
    "immer": "^10.2.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
